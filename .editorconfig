# Baseline whitespace rules, applied by the editor before Prettier ever runs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces is a hard line break in Markdown — don't strip it.
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
